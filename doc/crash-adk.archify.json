  "cards": [
    {
      "dot": "rose",
      "title": "The gap",
      "items": [
        "The money moved, but the session database has only the function call",
        "On resume ADK drops the dangling call and runs the tool again",
        "ADK documents this: at-least-once once resumed; tools must be idempotent"
      ]
    },
    {
      "dot": "amber",
      "title": "Who resumes",
      "items": [
        "A restarted or second host stays idle",
        "Something must find the invocation id and call resume"
      ]
